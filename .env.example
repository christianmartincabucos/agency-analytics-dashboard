# Copy to .env and add the read-only Infloww credentials supplied by your agency.
# Never commit .env or expose these values in Angular/browser code.
INFLOWW_API_KEY=your_read_only_infloww_api_key
INFLOWW_OID=your_agency_oid
INFLOWW_BASE_URL=https://openapi.infloww.com/v1
PORT=4444
CACHE_TTL_SECONDS=300
AMOUNT_DIVISOR=100
